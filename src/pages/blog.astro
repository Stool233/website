---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogExplorer from "../components/BlogExplorer";
import { summarizePost } from "../utils/blog";
import { getPosts } from "../utils/posts";

export const prerender = true;

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Blog posts">
  <h1 class="text-title mb-3">Blog</h1>
  <p class="mb-8 text-ink-secondary dark:text-ink-dark-secondary">Notes on agents, infrastructure, and building better software.</p>
  <BlogExplorer posts={posts.map(summarizePost)} client:load />
</BaseLayout>
